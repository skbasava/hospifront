# Copy to deployment/bff/.env and fill in the keys generated in Frappe Desk.
PORT=3001

# Inside docker compose this is overridden to http://frontend:8080.
# For local dev against a local Frappe: http://localhost:8080
FRAPPE_BASE_URL=http://localhost:8080

# Frappe Desk → (user) → API Access → Generate Keys.
# For a first run you may use the Administrator user's keys;
# create a dedicated least-privilege integration user before any real deployment.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Shared token the React app must send as `Authorization: Bearer <token>`.
# Empty = no check (local development only).
BFF_API_TOKEN=

# Browser origins allowed to call the BFF directly (dev servers).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

UPSTREAM_TIMEOUT_MS=8000

# Optional override for how the deployment reports itself in /api/v1/health
# (local | remote). Normally derived automatically from FRAPPE_BASE_URL.
# DEPLOY_MODE=remote
