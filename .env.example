# Target switch: local or remote
FRAPPE_TARGET=remote

# Remote Frappe site
FRAPPE_REMOTE_BASE_URL=https://frappe.abhidigitech.com
FRAPPE_REMOTE_API_KEY=
FRAPPE_REMOTE_API_SECRET=
FRAPPE_REMOTE_SITE=frappe.abhidigitech.com
FRAPPE_REMOTE_TIMEOUT=15

# Local Frappe bench site
FRAPPE_LOCAL_BASE_URL=http://127.0.0.1:8000
FRAPPE_LOCAL_API_KEY=
FRAPPE_LOCAL_API_SECRET=
FRAPPE_LOCAL_SITE=
FRAPPE_LOCAL_TIMEOUT=15

# Legacy remote aliases remain supported:
# FRAPPE_BASE_URL=
# FRAPPE_API_KEY=
# FRAPPE_API_SECRET=
# FRAPPE_TIMEOUT=15
